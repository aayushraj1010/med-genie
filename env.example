# JWT Security Configuration
# ⚠️ CRITICAL: Never commit actual JWT_SECRET to version control
# Generate a strong secret: openssl rand -base64 64

# Required: Strong JWT secret (minimum 64 characters)
JWT_SECRET=your-super-secure-jwt-secret-minimum-64-characters-long

# JWT Token Expiration Settings
JWT_EXPIRES_IN=15m                    # Access token lifetime (short for security)
REFRESH_TOKEN_EXPIRES_IN=7d           # Refresh token lifetime

# Security Headers
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="file:./dev.db"

# for google login: 
# Go to https://console.cloud.google.com/ signup and create new project, complete all steps, and after generating credentials fill up credentials of your project:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Google AI (Gemini) API Key — REQUIRED for chatbot functionality
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-api-key-here

# Gemini API Key — used by the LangChain agent (src/ai/agent.ts)
# Can be the same key as GOOGLE_API_KEY
GEMINI_API_KEY=your-google-ai-api-key-here

# Environment
NODE_ENV=development
