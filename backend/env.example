# Copy to backend/.env. Never commit credentials.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dev.db
# Set a persistent random secret (at least 32 characters in production).
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:9004","http://127.0.0.1:9004"]
GOOGLE_AI_API_KEY=
# Set to a Gemini model available to your account.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=8
API_SETU_KEY=

# Password recovery: use the frontend origin (HTTPS in production).
FRONTEND_URL=http://localhost:9004
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# For implicit SSL (usually port 465), set TLS=false and SSL=true.
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
